# Frontend config — copy to .env if your backend runs elsewhere.
VITE_API_URL=http://localhost:8080

# Sentry Monitoring (Frontend React)
# Get your DSN from Sentry Dashboard: Project Settings -> Client Keys (DSN)
VITE_SENTRY_DSN=
# Optional release version tag (defaults to moodila-frontend@1.0.0)
VITE_SENTRY_RELEASE=moodila-frontend@1.0.0
# Traces sample rate (0.0 to 1.0; recommended 0.1 for free tier, 0.0 in dev)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

