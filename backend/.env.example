# Backend configuration — copy to backend/.env and fill in your values.
# .env is gitignored; never commit real credentials.

# HTTP port the API listens on.
PORT=8080

# Supabase Postgres connection string (URI).
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Recommended: the "Session pooler" URI (IPv4-friendly, port 5432), e.g.:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The transaction pooler (port 6543) also works — we use the simple query protocol.
DATABASE_URL=

# Secret used to sign JWTs (Feature 1). Change this in production.
JWT_SECRET=dev-secret-change-me

# Allowed CORS origins (comma-separated, e.g. http://localhost:5173,https://app.moodila.com)
CORS_ORIGIN=http://localhost:5173

# Public URL of this API. It is used for short-lived photo upload URLs.
API_PUBLIC_URL=http://localhost:8080

# development | production
APP_ENV=development

# Cookie settings for auth (lax | none | strict). Set to 'none' if frontend and backend are cross-site.
COOKIE_SAMESITE=lax
# Optional shared domain (e.g. .yourdomain.com for subdomains)
COOKIE_DOMAIN=
COOKIE_SECURE=true

# S3-compatible photo storage. Both keys are required to sign browser uploads;
# keep them on the API only and never expose them to Vite.
# For AWS S3 leave S3_ENDPOINT empty. For R2, MinIO, B2, etc. use its API endpoint.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=entry-photos
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
# The public CDN/bucket URL used in photo_url, without the bucket name if it is
# already part of the hostname. Example: https://cdn.example.com
S3_PUBLIC_BASE_URL=
# Set true only when a provider requires path-style API URLs. Custom endpoints
# use path-style automatically; this flag is principally for AWS-compatible setups.
S3_FORCE_PATH_STYLE=false

# Password Reset & Resend Email Configuration
# TTL for password reset tokens in minutes (default: 30)
RESET_TOKEN_TTL_MINUTES=30
# Resend API Key. If empty, reset link is logged to console for local dev.
RESEND_API_KEY=
# Sender email address for Resend (default: onboarding@resend.dev)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Frontend URL used for constructing password reset links
APP_BASE_URL=http://localhost:5173,http://localhost:5174

# Google Drive Database Backups (Every 3 Hours)
# Recommended for Personal Google Drive (5TB): Use OAuth2 Refresh Token
# Generate token once using: go run ./cmd/token
GDRIVE_REFRESH_TOKEN=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# Service Account fallback (if not using OAuth2)
GDRIVE_CREDENTIALS_JSON=
GDRIVE_CREDENTIALS_FILE=
# The ID of the folder on your Google Drive
GDRIVE_FOLDER_ID=
# Backup interval in hours (default: 3)
BACKUP_INTERVAL_HOURS=3
# Backup retention policy in days (default: 7)
BACKUP_RETENTION_DAYS=7
# Enable/disable automatic background backups (default: true)
ENABLE_AUTO_BACKUP=true

