# Backend configuration — copy to backend/.env and fill in your values.
# .env is gitignored; never commit real credentials.

# HTTP port the API listens on.
PORT=8080

# Supabase Postgres connection string (URI).
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Recommended: the "Session pooler" URI (IPv4-friendly, port 5432), e.g.:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The transaction pooler (port 6543) also works — we use the simple query protocol.
DATABASE_URL=REDACTED

# Secret used to sign JWTs (Feature 1). Change this in production.
JWT_SECRET=dev-secret-change-me

# Allowed CORS origin — the Vite dev server.
CORS_ORIGIN=http://localhost:5173

# development | production
APP_ENV=development
